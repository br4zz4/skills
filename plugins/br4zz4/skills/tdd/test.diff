#!/usr/bin/env bash
set -euo pipefail

base="${1:-}"
if [ -z "$base" ]; then
  base="$(git merge-base HEAD origin/main 2>/dev/null || git merge-base HEAD origin/master 2>/dev/null || git rev-parse HEAD~1)"
fi

changed="$({ git diff --relative --name-only "$base"; git ls-files --others --exclude-standard; } | sort -u)"
tests=()
while IFS= read -r file; do
  [ -f "$file" ] || continue
  case "$file" in
    *_test.rb | *_spec.rb) tests+=("$file") ;;
    *.rb)
      name="$(basename "$file" .rb)"
      while IFS= read -r match; do tests+=("$match"); done < <(find test spec -type f \( -name "${name}_test.rb" -o -name "${name}_spec.rb" \) 2>/dev/null)
      ;;
  esac
done <<< "$changed"

if [ "${#tests[@]}" -eq 0 ]; then
  echo "test.diff: no test matches the files changed since $base"
  exit 0
fi

unique="$(printf '%s\n' "${tests[@]}" | sort -u)"
echo "test.diff: $(printf '%s\n' "$unique" | wc -l | tr -d ' ') test file(s) since $base"

if [ "${TEST_DIFF_RETEST:-}" = "1" ] && [ -f config/application.rb ] && bundle exec retest --version >/dev/null 2>&1; then
  exec bundle exec retest --diff "$base" --rails
elif printf '%s\n' "$unique" | grep -q '_spec\.rb$'; then
  exec bundle exec rspec $unique
elif [ -x bin/rails ]; then
  exec bin/rails test $unique
else
  exec bundle exec ruby -Itest -Ilib -e 'ARGV.each { |file| require File.expand_path(file) }' $unique
fi
